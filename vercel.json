{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": [
    {
      "name": "client",
      "root": "client",
      "framework": "vite"
    },
    {
      "name": "server",
      "root": "server",
      "framework": "express"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
